# ============================================================
# Aura Skincare AI Voice Agent - Environment Configuration
# ============================================================

# [SERVER-ONLY] Google Gemini API Key
# Required for generating ephemeral tokens for Gemini Live and post-call summaries.
# NEVER expose this key to the browser or prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here

# [SERVER-ONLY] SQLite / Prisma Database Connection URL
# Local file database storing evaluation orders and call logs.
DATABASE_URL="file:./dev.db"
